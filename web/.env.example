# ─── Supabase ────────────────────────────────────────────────────────────────
# Both of these are public by design: they ship in the browser bundle, and
# every table they can reach is protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses RLS. Never prefix this NEXT_PUBLIC_, never commit it.
# Not needed to run the app; required by the weekly-challenge job (M3) and by
# any future admin tooling.
SUPABASE_SECRET_KEY=sb_secret_...

# Set to "true" only after Google is enabled in Supabase
# (Dashboard → Authentication → Providers → Google). Left unset, the sign-in
# page offers the email link only, rather than a button that returns
# "provider is not enabled".
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# ─── AI coach ────────────────────────────────────────────────────────────────
# Server-only, read by /api/coach. Leave it unset and the camera screen falls
# back to its built-in cues — the app works, the coach is just not live.
ANTHROPIC_API_KEY=sk-ant-...

# There is deliberately no site-URL variable. Origins are derived from the
# request being served, so localhost, Vercel previews and production all work
# unchanged. Origins are listed in Supabase's redirect allowlist instead —
# see docs/M2-DEPLOY.md.
